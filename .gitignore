# Local configuration (contains credentials)
/config/config.local.php

# Runtime data
/storage/logs/*
/storage/tmp/*
!/storage/logs/.gitkeep
!/storage/tmp/.gitkeep

# Local databases
*.sqlite
*.sqlite-wal
*.sqlite-shm

